const news = document.getElementById("news");
const result = document.getElementById("result");
const counter = document.getElementById("counter");

news.addEventListener("input", () => {
  counter.textContent = `${news.value.length} / 10000 characters`;
});

function displayResult(type, icon, title, message, tips) {
  result.className = "result " + type;
  result.replaceChildren();

  const iconEl = document.createElement("div");
  iconEl.className = "result-icon";
  iconEl.textContent = icon;

  const heading = document.createElement("h2");
  heading.textContent = title;

  const paragraph = document.createElement("p");
  paragraph.textContent = message;

  const list = document.createElement("ul");

  tips.forEach(tip => {
    const item = document.createElement("li");
    item.textContent = tip;
    list.appendChild(item);
  });

  result.append(iconEl, heading, paragraph, list);
}

document.getElementById("checkBtn").addEventListener("click", () => {
  const text = news.value.trim().toLowerCase();

  if (text.length < 20) {
    displayResult("", "✍️", "Enter more news",
      "Please enter at least 20 characters.",
      ["Paste a headline or a short news article."]);
    return;
  }

  const warnings = [
    "shocking",
    "miracle cure",
    "100% guaranteed",
    "share immediately",
    "you won't believe",
    "secret they don't want you to know",
    "forward to everyone",
    "no side effects",
    "guaranteed cure"
  ];

  const matches = warnings.filter(word => text.includes(word));

  if (matches.length >= 2) {
    displayResult("fake", "🚩", "Multiple warning phrases",
      "This text uses multiple warning phrases. That does not prove it is fake.",
      ["Find the original source.", "Check independent reports.",
       "Verify evidence before sharing."]);
  } else if (matches.length === 1) {
    displayResult("suspicious", "⚠️", "Further checking needed",
      "A warning phrase was found. The claim has not been verified.",
      ["Check the author and date.", "Compare trusted news sources.",
       "Look for evidence supporting the claim."]);
  } else {
    displayResult("genuine", "🔎", "No listed warning phrases",
      "No demo warning phrases were found. This does not prove the story is genuine.",
      ["Verify the original source.", "Check independent reporting.",
       "Confirm dates, figures and context."]);
  }
});

document.getElementById("clearBtn").addEventListener("click", () => {
  news.value = "";
  counter.textContent = "0 / 10000 characters";

  displayResult("", "🔎", "Ready to investigate?",
    "Your result will appear here.", []);
  news.focus();
});

// Register the offline service worker on the published HTTPS site.
if ("serviceWorker" in navigator && location.protocol === "https:") {
  window.addEventListener("load", () => {
    navigator.serviceWorker.register("./sw.js").catch(error => {
      console.error("Offline setup failed:", error);
    });
  });
}
