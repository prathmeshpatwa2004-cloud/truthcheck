
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  color: #17243a;
  background-color: #f4f0e6;
  background-image:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgba(65, 55, 35, 0.035) 4px
    ),
    radial-gradient(#d6cbb5 0.6px, transparent 0.6px);
  background-size: auto, 7px 7px;
}

.app {
  width: min(100% - 28px, 820px);
  margin: 25px auto;
}

.hero {
  text-align: center;
  color: white;
  background: linear-gradient(135deg, #102849, #176b87);
  border-radius: 22px;
  padding: 35px 22px;
  box-shadow: 0 8px 25px #10284930;
}

.logo {
  font-size: 22px;
  font-weight: 800;
  letter-spacing: 0.5px;
}

.tagline {
  color: #f8d477;
  font-size: 13px;
  letter-spacing: 3px;
  text-transform: uppercase;
}

.hero h1 {
  font-size: clamp(28px, 6vw, 44px);
  margin: 22px 0 12px;
}

.hero p {
  line-height: 1.6;
}

.pill {
  display: inline-block;
  margin-top: 10px;
  padding: 8px 13px;
  border: 1px solid #ffffff70;
  border-radius: 30px;
  font-size: 12px;
}

.panel {
  background: #fffdf8;
  margin-top: 20px;
  padding: 25px;
  border-radius: 18px;
  border: 1px solid #e4ddcd;
  box-shadow: 0 5px 18px #2b251515;
}

label {
  display: block;
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 12px;
}

textarea {
  width: 100%;
  min-height: 170px;
  resize: vertical;
  padding: 15px;
  font: inherit;
  font-size: 15px;
  line-height: 1.6;
  border: 1px solid #c8c9ce;
  border-radius: 12px;
  background: #fff;
  color: #17243a;
  outline: none;
}

textarea:focus {
  border-color: #176b87;
  box-shadow: 0 0 0 3px #176b871c;
}

.actions {
  display: flex;
  gap: 12px;
  margin-top: 15px;
}

button {
  flex: 1;
  min-height: 48px;
  border: none;
  border-radius: 10px;
  background: #176b87;
  color: white;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  padding: 12px;
}

button:active {
  transform: scale(0.98);
}

button:focus-visible {
  outline: 3px solid #e8b94c;
  outline-offset: 3px;
}

button.secondary {
  flex: 0 0 auto;
  background: #e8eaf0;
  color: #17243a;
}

#counter {
  text-align: right;
  color: #687387;
  font-size: 12px;
}

.result {
  margin-top: 22px;
  padding: 22px;
  border-radius: 14px;
  text-align: center;
  background: #f0f3f7;
  border: 1px solid #dce2ea;
  overflow-wrap: anywhere;
}

.result-icon {
  font-size: 34px;
}

.result h2 {
  font-size: 21px;
  margin: 10px 0;
}

.result p {
  line-height: 1.6;
}

.result ul {
  text-align: left;
  line-height: 1.8;
}

.result.genuine {
  background: #eaf4ee;
  border-color: #b7d9c2;
}

.result.suspicious {
  background: #fff5df;
  border-color: #ead39b;
}

.result.fake {
  background: #faeaea;
  border-color: #e6b8b8;
}

.tips {
  margin-top: 27px;
  padding-top: 10px;
}

.tips h2 {
  font-size: 19px;
}

.tips ul {
  padding-left: 22px;
  line-height: 1.9;
  color: #46536a;
}

.disclaimer {
  padding: 13px;
  background: #f5efe1;
  border-left: 4px solid #d6a93c;
  border-radius: 5px;
  color: #65583e;
  font-size: 12px;
  line-height: 1.7;
}

footer {
  padding: 20px 5px;
  text-align: center;
  color: #647086;
  font-size: 13px;
}

@media (max-width: 480px) {
  .app {
    width: calc(100% - 20px);
    margin: 10px auto;
  }

  .hero {
    padding: 28px 16px;
    border-radius: 16px;
  }

  .panel {
    padding: 17px;
  }

  textarea {
    min-height: 155px;
    font-size: 16px;
  }

  .actions {
    flex-direction: column;
  }

  button.secondary {
    flex: auto;
  }
}
