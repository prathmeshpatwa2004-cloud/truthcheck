
* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: Arial, sans-serif;
  color: #17243a;
  background-color: #f4f0e6;
  background-image: radial-gradient(#cfc5b1 0.7px, transparent 0.7px);
  background-size: 8px 8px;
}

.app {
  width: min(100% - 24px, 720px);
  margin: 16px auto;
}

.hero {
  background: linear-gradient(135deg, #102849, #176b87);
  color: white;
  text-align: center;
  padding: 30px 18px;
  border-radius: 20px;
}

.logo { font-size: 23px; font-weight: 800; }

.tagline {
  color: #f8d477;
  font-size: 12px;
  letter-spacing: 2px;
}

h1 { font-size: clamp(27px, 7vw, 40px); }

.hero p { line-height: 1.6; }

.panel {
  background: #fffdf8;
  padding: 20px;
  margin-top: 16px;
  border: 1px solid #e4ddcd;
  border-radius: 18px;
}

label { display: block; font-weight: bold; margin-bottom: 10px; }

textarea {
  width: 100%;
  min-height: 155px;
  padding: 14px;
  border: 1px solid #c8c9ce;
  border-radius: 12px;
  font: inherit;
  font-size: 16px;
  line-height: 1.6;
  resize: vertical;
}

textarea:focus {
  outline: 2px solid #176b87;
  outline-offset: 2px;
}

#counter {
  text-align: right;
  font-size: 12px;
  color: #687387;
}

.actions { display: flex; gap: 10px; }

button {
  flex: 1;
  padding: 14px 10px;
  min-height: 48px;
  border: 0;
  border-radius: 10px;
  background: #176b87;
  color: white;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
}

.secondary {
  flex: 0 0 85px;
  background: #e8eaf0;
  color: #17243a;
}

.result {
  margin-top: 22px;
  padding: 18px;
  text-align: center;
  border-radius: 14px;
  background: #f0f3f7;
  overflow-wrap: anywhere;
}

.result-icon { font-size: 34px; }
.result h2 { font-size: 21px; }
.result p { line-height: 1.6; }

.result ul { text-align: left; line-height: 1.8; }

.result.suspicious { background: #fff2d4; }
.result.fake { background: #fae5e5; }
.result.genuine { background: #e6f4e9; }

.tips-title { margin-top: 25px; font-size: 19px; }
.tips { padding-left: 22px; line-height: 1.9; }

.disclaimer {
  padding: 12px;
  background: #f5efe1;
  border-left: 4px solid #d6a93c;
  font-size: 12px;
  line-height: 1.7;
}

footer {
  text-align: center;
  padding: 20px 5px;
  color: #647086;
  font-size: 13px;
}

@media (max-width: 380px) {
  .panel { padding: 14px; }
  .hero { padding: 25px 12px; }
  .actions { flex-direction: column; }
  .secondary { flex: auto; }
}
